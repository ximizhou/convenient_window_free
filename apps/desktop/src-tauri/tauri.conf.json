{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "便捷窗口",
  "version": "0.1.6",
  "identifier": "com.ximizhou.convenientwindow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便捷窗口",
        "width": 1220,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:56873; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Windows 11 热区、窗口与鼠标增强工具",
    "longDescription": "便捷窗口提供热区、贴边隐藏、全局鼠标手势、截图、本地 OCR 和窗口置顶能力。",
    "publisher": "ximizhou",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../target/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "resources/helper/*.exe": "helper/",
      "resources/helper/*.dll": "helper/",
      "resources/helper/payload-manifest.json": "helper/payload-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
